# Copy to frontend/.env and fill in. Vite reads it automatically (no dotenv needed).
# Only VITE_-prefixed vars reach the browser, so never put secrets here.

# Base URL of the Django API, no trailing slash. Leave empty locally: the Vite
# dev server proxies /api to localhost:8000.
# Production example: https://pc-flipper-toolkit-api.onrender.com
VITE_API_URL=
