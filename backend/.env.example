# Copy to backend/.env and fill in. Never commit .env.

# 1 = local development. Leave unset or 0 in production.
DEBUG=1

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres via Unix socket. Production: the Neon connection string.
DATABASE_URL=postgres:///pc_flipper_toolkit

# Frontend origins allowed to call the API. Not needed locally (Vite proxies /api).
# Production example: https://pc-flipper-toolkit.vercel.app
CORS_ALLOWED_ORIGINS=

# Proxies in front of Django that add to X-Forwarded-For (for the log-in rate limit).
# 0 locally. Render: 3 (Cloudflare, Render's load balancer and a local proxy each add one; checked 2026-10-27).
NUM_PROXIES=0

# Sign in with Google: the OAuth client's id (docs/specs/google-sign-in.md), the same one
# as the frontend's VITE_GOOGLE_CLIENT_ID. It isn't a secret. Empty: no Google sign-in.
GOOGLE_CLIENT_ID=

# Email through Brevo's SMTP relay (docs/specs/account-management.md). Leave EMAIL_HOST
# empty locally: emails then print in runserver's output instead of being sent.
# Production: EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=2525 (Render's free plan blocks
# 587, 465 and 25; Brevo also listens on 2525), EMAIL_USE_TLS=1, the SMTP login
# from Brevo's SMTP page as EMAIL_HOST_USER, and an SMTP key (not an API key) as
# EMAIL_HOST_PASSWORD. The key expires after a year, or after 90 days unused.
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The sender verified in Brevo, e.g. PC Flipper Toolkit <pcflippertoolkit@gmail.com>
DEFAULT_FROM_EMAIL=
# The frontend, for links in emails. Production: https://pc-flipper-toolkit.vercel.app
SITE_URL=http://localhost:5173
