# Copy to backend/.env and fill in. Never commit .env.

# 1 = local development. Leave unset or 0 in production.
DEBUG=1

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres via Unix socket. Production: the Neon connection string.
DATABASE_URL=postgres:///pc_flipper_toolkit

# Frontend origins allowed to call the API. Not needed locally (Vite proxies /api).
# Production example: https://pc-flipper-toolkit.vercel.app
CORS_ALLOWED_ORIGINS=

# Secret required on POST/PATCH/DELETE (SPEC: access key). Empty refuses every write.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_KEY=
